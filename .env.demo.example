# Salin menjadi .env.demo lalu ganti nilainya. Dipakai HANYA oleh docker-compose.demo.yml.
POSTGRES_USER=stockfolio
POSTGRES_PASSWORD=ganti_password_demo
POSTGRES_DB=stockfolio_demo
# Password di URL harus sama dengan POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://stockfolio:ganti_password_demo@db:5432/stockfolio_demo
REDIS_URL=redis://redis:6379/0
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"  (min. 32 karakter)
SECRET_KEY=ganti_dengan_string_acak_panjang
# Mode demo: data harga simulasi, tanpa internet, tanpa sync, tanpa penjadwal
DEMO_MODE=true
SCHEDULER_ENABLED=false
ALLOW_REGISTRATION=false
ENABLE_DOCS=false
