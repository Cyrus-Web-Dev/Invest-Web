# Salin menjadi .env lalu ganti nilainya
POSTGRES_USER=stockfolio
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=stockfolio
# Password di URL harus sama dengan POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://stockfolio:ganti_password_ini@db:5432/stockfolio
REDIS_URL=redis://redis:6379/0
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"  (min. 32 karakter)
SECRET_KEY=ganti_dengan_string_acak_panjang
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Opsional (nilai bawaan sudah wajar)
# SCHEDULER_ENABLED=true
# PRICE_CACHE_TTL_SECONDS=300
# SYNC_COOLDOWN_SECONDS=60
# HISTORY_BACKFILL_DAYS=365
# ALLOW_REGISTRATION=true   # ubah ke false setelah akun Anda dibuat jika aplikasi dipublikasikan
# ENABLE_DOCS=true          # ubah ke false di produksi
